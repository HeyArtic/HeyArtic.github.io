---
import { t, tr } from '../i18n/server';

interface Props {
  id: string;
  command: string;
  title: string;
  intro?: string;
}
const { id, command, title, intro } = Astro.props;
---
<header class="section-head reveal">
  <p class="cmd-line">
    <span class="cmd-prompt" aria-hidden="true">$</span>
    <span {...tr(command)}>{t(command)}</span>
  </p>
  <h2 class="section-title" id={id} {...tr(title)}>{t(title)}</h2>
  {intro && <p class="section-intro" {...tr(intro)}>{t(intro)}</p>}
  <slot />
</header>
